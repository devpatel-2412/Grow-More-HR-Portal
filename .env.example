# ── Server ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# In production, set this to your actual frontend origin(s), comma-separated —
# e.g. https://your-app.vercel.app
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# The single canonical frontend URL — used to build clickable links in invite/password-reset
# emails. In production, set this to your real frontend origin, e.g. https://your-app.vercel.app
APP_URL=http://localhost:3000

# ── Database (Prisma / Postgres) ────────────────────────────────────────────
# Supabase only — dev and prod share the one project. DATABASE_URL is the pooled "Session"
# connection string (port 5432, used by the running app for normal queries and safe to append
# `?connection_limit=N` to). DIRECT_URL is the same host, used only by `prisma migrate` (pooled
# connections can't run the advisory locks migrations need). Both are on the same page:
# Project Settings → Database → Connection string.
#
# Running integration tests locally? Point both at `?schema=test` instead of the default
# `public` schema so table truncation between tests never touches real data — see
# docs/module-1-foundation/deployment.md.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?connection_limit=5"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?connection_limit=2"

# ── JWT ──────────────────────────────────────────────────────────────────
# Generate a strong secret, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET=changeme-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_REFRESH_TTL_REMEMBER_ME=30d

# ── Two-Factor Authentication ───────────────────────────────────────────────
# AES-256-GCM key used to encrypt TOTP secrets at rest. Must be a 32-byte
# value, base64 encoded, e.g.: openssl rand -base64 32
TWO_FA_ENCRYPTION_KEY=changeme-32-byte-base64-key
TWO_FA_ISSUER=Grow More

# ── Refresh Token Cookie ────────────────────────────────────────────────────
REFRESH_COOKIE_NAME=refresh_token
# Left blank: same-origin deployment (via the Vercel rewrite proxying /api to Railway), no
# explicit cookie domain needed. Only set this if the frontend and API are on different
# registrable domains that aren't unified behind a same-origin proxy.
REFRESH_COOKIE_DOMAIN=

# ── Bootstrap Super Admin (one-time) ────────────────────────────────────────
# Public registration is permanently closed — there is no sign-up page or API. Every user is
# provisioned internally (Super Admin creates companies + invites their first Admin; that Admin/HR
# invites everyone else). That leaves one bootstrapping problem: the very first account. Set both
# of these and the server creates exactly one SUPER_ADMIN on boot, the first time it starts with
# zero SUPER_ADMIN users in the database. Safe to leave set indefinitely — every later boot is a
# no-op once a SUPER_ADMIN already exists. Log in with these credentials, then change the password.
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=

# ── Rate Limiting ────────────────────────────────────────────────────────
# Left blank to use the in-memory rate-limit store (single-instance only — correct for the
# current single Railway instance). Set to a redis:// URL (e.g. Upstash) only once you actually
# run more than one API instance; nothing else needs to change to add it later.
REDIS_URL=

# ── Email (Gmail API — OAuth 2.0, no SMTP / no App Password) ───────────────────────
# Left blank in dev: emails are logged to the console instead of sent. Required in
# production — the app refuses to start sending real emails without this configured.
# All five must be set together (a partial set fails startup validation on purpose).
# See docs/module-1-foundation/gmail-api-setup.md for the full Google Cloud + OAuth walkthrough,
# including exactly how to generate GOOGLE_REFRESH_TOKEN.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=https://developers.google.com/oauthplayground
GOOGLE_SENDER_EMAIL=

# ── File Storage (Supabase Storage) ─────────────────────────────────────────
# Left blank in dev: files are written to a local .local-storage/ folder instead (gitignored,
# served through a dedicated dev-only signed-URL route). Required in production — the app
# refuses to accept uploads without this configured.
# SUPABASE_URL: Project Settings → API → Project URL.
# SUPABASE_SERVICE_ROLE_KEY: Project Settings → API → service_role key (NOT the anon/public key
# — this one bypasses row-level security and must never be exposed to the frontend).
# SUPABASE_STORAGE_BUCKET: create a private bucket in Storage first (any name); default below.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

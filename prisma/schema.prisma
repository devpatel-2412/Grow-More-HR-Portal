datasource db {
  provider  = "postgresql"
  // Runtime queries go through Supabase's connection pooler (pgbouncer, port 6543) — fine for
  // app traffic, but pooled connections don't support the advisory locks Prisma's migration
  // engine needs. directUrl (port 5432, unpooled) is used automatically for migrate/db-push
  // only; nothing else changes. Locally, both can point at the same docker-compose Postgres.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Exactly 6 fixed roles — no custom roles, no additions through the UI. SUPER_ADMIN always has
// full access (short-circuited in permission-resolver.service.ts, never DB-driven). The other 5
// roles' access is entirely decided by a SUPER_ADMIN through the Roles & Permissions page and
// stored in the dynamic Role/RolePermission tables — see permission-resolver.service.ts.
enum UserRole {
  SUPER_ADMIN
  ADMIN
  HR_MANAGER
  PROJECT_MANAGER
  TEAM_LEADER
  EMPLOYEE
}


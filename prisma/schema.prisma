model Tenant {
  id             String  @id @default(uuid())
  name           String
  domain         String  @unique
  logoUrl        String?
  primaryColor   String  @default("#0f172a")
  secondaryColor String  @default("#3b82f6")
  font           String  @default("Inter")

  // Attendance policy — same "flat fields on Tenant" pattern as branding above.
  attendanceShiftStartMinutes         Int     @default(570) // 09:30 = 9*60+30
  attendanceRequiredWorkMinutes       Int     @default(540) // 9 hours
  attendanceAllowedBreakMinutes       Int     @default(45)
  attendanceBreakOverageExtendsLogout Boolean @default(true)

  // Payroll policy — statutory rates vary by jurisdiction and change year to year, so they are
  // tenant-configurable rather than hardcoded. Defaults follow common Indian statutory rates and
  // MUST be confirmed against the tenant's own jurisdiction before running live payroll.
  payrollPfEmployeeRate      Float @default(0.12) // 12% of PF-eligible wage
  payrollPfWageCeiling       Float @default(15000)
  payrollEsicEmployeeRate    Float @default(0.0075) // 0.75% of gross
  payrollEsicWageCeiling     Float @default(21000) // ESIC does not apply above this gross
  payrollProfessionalTax     Float @default(200) // flat monthly amount
  payrollTdsRate             Float @default(0) // flat fallback; real TDS needs per-employee declarations
  payrollOvertimeMultiplier  Float @default(1.5)
  payrollWorkingDaysPerMonth Int   @default(26)

  // GST (Indian tax) registration — optional. When both this and a finance document's
  // placeOfSupplyStateCode are set, tax is split into CGST/SGST (same state) or IGST (different
  // state) instead of staying a single flat taxAmount.
  gstin        String?
  gstStateCode String?

  // Session security policy — same tenant-configurable pattern as attendance/payroll above.
  // null on sessionTimeoutMinutes means "never expire due to inactivity" (opt-in, not default).
  sessionTimeoutMinutes  Int?      @default(60)
  sessionWarningMinutes  Int       @default(2)
  rememberMeDurationDays Int       @default(30)
  maxConcurrentSessions  Int?
  // Bumped to now() by "Force logout all users" — any refresh token issued before this instant
  // is treated as invalid on its next use, without touching individual token rows.
  forceLogoutAllAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  employeeProfiles      EmployeeProfile[]
  jobPostings           JobPosting[]
  assets                Asset[]
  projects              Project[]
  financeDocs           FinanceDocument[]
  visitors              Visitor[]
  bookings              RoomBooking[]
  kbArticles            KnowledgeBaseArticle[]
  tickets               Ticket[]
  documents             SecureDocument[]
  documentVersions      DocumentVersion[]
  templates             CanvaTemplate[]
  subscriptions         Subscription[]
  invites               Invite[]
  auditLogs             AuditLog[]
  attendances           Attendance[]
  regularizations       AttendanceRegularization[]
  leaveRequests         LeaveRequest[]
  tasks                 Task[]
  milestones            Milestone[]
  taskComments          TaskComment[]
  taskAttachments       TaskAttachment[]
  dailyWorkReports      DailyWorkReport[]
  timeLogs              TimeLog[]
  salaryStructures      SalaryStructure[]
  payrollRuns           PayrollRun[]
  payrollItems          PayrollItem[]
  candidates            Candidate[]
  interviews            Interview[]
  leads                 Lead[]
  crmActivities         CrmActivity[]
  ticketComments        TicketComment[]
  generatedDocuments    GeneratedDocument[]
  announcements         Announcement[]
  branches              Branch[]
  teams                 Team[]
  checklistItems        OnboardingChecklistItem[]
  lifecycleEvents       LifecycleEvent[]
  fnfSettlements        FnfSettlement[]
  vendors               Vendor[]
  inventoryItems        InventoryItem[]
  inventoryTransactions InventoryTransaction[]
  sops                  Sop[]
  sopRevisions          SopRevision[]
  notifications         Notification[]
  roles                 Role[]
  departmentPermissions DepartmentPermission[]
  branchPermissions     BranchPermission[]
  emailLogs             EmailLog[]
}

model User {
  id                         String     @id @default(uuid())
  email                      String     @unique
  passwordHash               String
  role                       UserRole   @default(EMPLOYEE)
  status                     UserStatus @default(PENDING_INVITE)
  tenantId                   String
  tenant                     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  is2FAEnabled               Boolean    @default(false)
  twoFactorSecret            String?
  twoFactorRecoveryCodesHash String[]   @default([])
  lastLoginAt                DateTime?
  failedLoginCount           Int        @default(0)
  lockedUntil                DateTime?
  createdAt                  DateTime   @default(now())
  updatedAt                  DateTime   @updatedAt

  profile             EmployeeProfile?
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  roleAssignments     UserRoleAssignment[]

  @@index([tenantId])
  @@index([tenantId, role])
  @@index([tenantId, status])
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique
  familyId          String
  deviceInfo        String?
  ipAddress         String?
  userAgent         String?
  expiresAt         DateTime
  revokedAt         DateTime?
  revokedReason     String?
  replacedByTokenId String?
  createdAt         DateTime  @default(now())
  // Bumped on every successful /auth/refresh — doubles as both "last activity" for the inactivity
  // timeout backstop and the "Last Activity" column on the session management dashboard.
  lastUsedAt        DateTime  @default(now())
  // Carried forward unchanged on every rotation so a session started without "remember me" stays
  // a true browser-session cookie on every subsequent refresh too, not just the first one.
  rememberMe        Boolean   @default(false)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model Invite {
  id          String       @id @default(uuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email       String
  role        UserRole
  tokenHash   String       @unique
  invitedById String?
  status      InviteStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime     @default(now())

  @@index([tenantId, email])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id          String      @id @default(uuid())
  tenantId    String?
  tenant      Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actorUserId String?
  actor       User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      AuditAction
  targetType  String?
  targetId    String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime    @default(now())

  @@index([tenantId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

/**
 * Dynamic RBAC layer — purely additive on top of the static UserRole enum + ROLE_PERMISSIONS map
 * (see src/server/shared/permissions/permissions.ts). A user's effective permissions are the union
 * of their static role's permissions and whatever these tables grant; neither replaces the other,
 * and the static map remains the fallback if this layer is ever unreachable. isSystem marks the 7
 * roles seeded 1:1 from the existing UserRole values (see prisma/seed-rbac.ts) — protected from
 * deletion so the static roles always have a corresponding, editable, non-destructible row.
 */
model Role {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isSystem    Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  permissions RolePermission[]
  assignments UserRoleAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model RolePermission {
  id         String   @id @default(uuid())
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission String
  createdAt  DateTime @default(now())

  @@unique([roleId, permission])
  @@index([roleId])
}

model UserRoleAssignment {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedById String?
  createdAt    DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model DepartmentPermission {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department String
  permission String
  createdAt  DateTime @default(now())

  @@unique([tenantId, department, permission])
  @@index([tenantId, department])
}

model BranchPermission {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  permission String
  createdAt  DateTime @default(now())

  @@unique([tenantId, branchId, permission])
  @@index([tenantId, branchId])
}

model EmployeeProfile {
  id               String            @id @default(uuid())
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId       String // e.g. EMP-2026-001 — unique per tenant, not globally (see @@unique below)
  firstName        String
  lastName         String
  phone            String?
  department       String
  designation      String
  address          String?
  emergencyContact String?
  dateOfJoining    DateTime
  dateOfBirth      DateTime?
  status           EmployeeStatus    @default(ONBOARDING)
  qrCodeUrl        String?
  cardPosterUrl    String?
  managerId        String?
  manager          EmployeeProfile?  @relation("ManagerToEmployee", fields: [managerId], references: [id])
  subordinates     EmployeeProfile[] @relation("ManagerToEmployee")
  branchId         String?
  branch           Branch?           @relation(fields: [branchId], references: [id])
  teamId           String?
  team             Team?             @relation("TeamMembers", fields: [teamId], references: [id])
  teamsLed         Team[]            @relation("TeamLead")

  attendance                  Attendance[]
  regularizations             AttendanceRegularization[]
  leaves                      LeaveRequest[]
  leavesToReview              LeaveRequest[]             @relation("LeaveManagerReview")
  assignedTasks               Task[]
  taskComments                TaskComment[]
  payrolls                    PayrollItem[]
  dailyReports                DailyWorkReport[]
  reviewedReports             DailyWorkReport[]          @relation("WorkReportReviewer")
  timeLogs                    TimeLog[]
  salaryStructures            SalaryStructure[]
  interviewPanels             Interview[]                @relation("InterviewPanel")
  ownedLeads                  Lead[]                     @relation("LeadOwner")
  crmActivities               CrmActivity[]              @relation("CrmActivityAuthor")
  createdFinanceDocs          FinanceDocument[]
  recordedFinancePayments     FinancePayment[]
  assets                      Asset[]
  tickets                     Ticket[]                   @relation("TicketEmployee")
  assignedTickets             Ticket[]                   @relation("TicketAssignedTo")
  ticketComments              TicketComment[]
  bookings                    RoomBooking[]
  articles                    KnowledgeBaseArticle[]
  hostedVisitors              Visitor[]
  uploadedDocuments           SecureDocument[]
  uploadedDocumentVersions    DocumentVersion[]
  createdTemplates            CanvaTemplate[]
  generatedDocumentsAsSubject GeneratedDocument[]        @relation("GeneratedDocumentSubject")
  generatedDocumentsAsAuthor  GeneratedDocument[]        @relation("GeneratedDocumentAuthor")
  publishedAnnouncements      Announcement[]
  checklistItems              OnboardingChecklistItem[]
  lifecycleEvents             LifecycleEvent[]
  fnfSettlement               FnfSettlement?
  inventoryTransactions       InventoryTransaction[]
  ownedSops                   Sop[]                      @relation("SopOwner")
  sopRevisions                SopRevision[]

  @@unique([tenantId, employeeId])
  @@index([tenantId])
  @@index([tenantId, department])
  @@index([managerId])
  @@index([branchId])
  @@index([teamId])
}

enum LifecycleEventType {
  CONFIRMATION
  PROMOTION
  TRANSFER
  EXIT_INITIATED
  EXIT_COMPLETED
}

enum FnfStatus {
  DRAFT
  APPROVED
  PAID
}

model OnboardingChecklistItem {
  id          String          @id @default(uuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  label       String
  isCompleted Boolean         @default(false)
  completedAt DateTime?
  createdAt   DateTime        @default(now())

  @@index([tenantId])
  @@index([employeeId])
}

/**
 * One row per lifecycle action taken on an employee — the audit trail a promotion/transfer/exit letter is generated from.
 */
model LifecycleEvent {
  id            String             @id @default(uuid())
  tenantId      String
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      EmployeeProfile    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type          LifecycleEventType
  effectiveDate DateTime
  previousValue String?
  newValue      String?
  notes         String?
  createdById   String?
  createdAt     DateTime           @default(now())

  @@index([tenantId])
  @@index([employeeId, createdAt])
}

/**
 * One settlement per employee — a re-hire after a prior exit is out of scope, same as elsewhere in this schema.
 */
model FnfSettlement {
  id              String          @id @default(uuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId      String          @unique
  employee        EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  lastWorkingDay  DateTime
  pendingSalary   Float           @default(0)
  leaveEncashment Float           @default(0)
  bonus           Float           @default(0)
  deductions      Float           @default(0)
  netPayable      Float
  status          FnfStatus       @default(DRAFT)
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([tenantId])
}

enum VendorStatus {
  ACTIVE
  INACTIVE
}

enum SopStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Sop {
  id          String           @id @default(uuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  category    String?
  department  String?
  version     Int              @default(1)
  status      SopStatus        @default(DRAFT)
  body        String
  fileUrl     String?
  ownerId     String?
  owner       EmployeeProfile? @relation("SopOwner", fields: [ownerId], references: [id])
  publishedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  revisions SopRevision[]

  @@unique([tenantId, title])
  @@index([tenantId, status])
}

/**
 * A snapshot of a published SOP's body taken just before each subsequent revision overwrites it.
 */
model SopRevision {
  id          String           @id @default(uuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sopId       String
  sop         Sop              @relation(fields: [sopId], references: [id], onDelete: Cascade)
  version     Int
  body        String

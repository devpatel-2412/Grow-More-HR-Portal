/**
 * Future-ready hook for an actual antivirus scan step — no scanner is wired in yet, so every
 * real upload lands as SKIPPED. Modelled now so adding a scanner later is a worker + a status
 * flip, not a schema change.
 */
enum DocumentScanStatus {
  PENDING
  CLEAN
  FLAGGED
  SKIPPED
}

model SecureDocument {
  id                String             @id @default(uuid())
  tenantId          String
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  category          String?
  folderPath        String             @default("/")
  /**
   * Legacy pasted-link documents only — null for anything uploaded through the real storage
   * pipeline, which uses `storageKey` instead. Never write both on the same row.
   */
  fileUrl           String?
  /**
   * Object key in the configured StorageService bucket. Set only for real uploads; the
   * download endpoint mints a fresh short-lived signed URL from this on every request rather
   * than persisting one, so the bucket is never exposed directly.
   */
  storageKey        String?
  fileSize          Int?
  mimeType          String?
  scanStatus        DocumentScanStatus @default(SKIPPED)
  /**
   * Generic linkage to the record this document belongs to (e.g. "EMPLOYEE"/employeeProfile.id,
   * "LEAVE_REQUEST"/leaveRequest.id, "VENDOR"/vendor.id) — kept as a loose type+id pair rather
   * than a dozen nullable foreign keys, since new attachment points are expected to keep being
   * added across modules. Null for general, unlinked company documents.
   */
  relatedEntityType String?
  relatedEntityId   String?
  version           Int                @default(1)
  expiresAt         DateTime?
  isDigitallySigned Boolean            @default(false)
  archived          Boolean            @default(false)
  archivedAt        DateTime?
  uploadedById      String?
  uploadedBy        EmployeeProfile?   @relation(fields: [uploadedById], references: [id])
  versions          DocumentVersion[]
  createdAt         DateTime           @default(now())

  @@index([tenantId, folderPath])
  @@index([tenantId, archived])
  @@index([tenantId, category])
  @@index([tenantId, relatedEntityType, relatedEntityId])
}

/**
 * Immutable snapshot of one prior file behind a SecureDocument — created on every upload and every replace, so "current" is just the highest `version` row and nothing is ever overwritten in place.
 */
model DocumentVersion {
  id           String           @id @default(uuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documentId   String
  document     SecureDocument   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version      Int
  fileUrl      String?
  storageKey   String?
  fileSize     Int?
  mimeType     String?
  uploadedById String?
  uploadedBy   EmployeeProfile? @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime         @default(now())

  @@unique([documentId, version])
  @@index([documentId])
}

enum NotificationType {
  TASK_ASSIGNED
  LEAVE_APPROVED
  LEAVE_REJECTED
  TICKET_ASSIGNED
  DOCUMENT_EXPIRING
  GENERIC
  LEAVE_REQUESTED
  PAYSLIP_AVAILABLE
  PROJECT_ASSIGNED
  TASK_READY_FOR_REVIEW
  TASK_COMPLETED
  TASK_REOPENED
  TASK_DUE_SOON
  TASK_OVERDUE
}

enum EmailStatus {
  SENT
  FAILED
}

/**
 * In-app notification for a single user login (not per-employee — mirrors AuditLog.actorUserId) — the bell icon in the app shell.
 */
model Notification {
  id        String           @id @default(uuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  /**
   * Frontend route to navigate to when the notification is clicked, e.g. "/tasks/123" — not a full URL.
   */
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
  @@index([tenantId, createdAt])
}

/**
 * One row per real send attempt through SmtpEmailService — never written by the dev-console
 * fallback, since that isn't a real delivery mechanism. tenantId is nullable because some
 * recipients (e.g. a recruitment candidate) have no tenant-scoped User account to attribute it
 * to. retryFailedEmails (see jobs/scheduler.ts) re-attempts FAILED rows up to a small cap.
 */
model EmailLog {
  id         String      @id @default(uuid())
  tenantId   String?
  tenant     Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  to         String
  subject    String
  template   String
  /**
   * The actual rendered bodies — stored so retryFailedEmails can resend the real content, not
   * just re-attempt with nothing to send.
   */
  html       String?
  text       String
  status     EmailStatus
  error      String?
  retryCount Int         @default(0)
  createdAt  DateTime    @default(now())
  sentAt     DateTime?

  @@index([status, retryCount])
  @@index([tenantId, createdAt])
}

/**
 * A reusable poster or letter template. POSTER_* types carry a background image plus positioned
 * text overlays (layoutFields); LETTER_* types carry a plain-text body with {{variable}}
 * placeholders. There is no in-browser drag canvas library wired in — positions are edited via
 * numeric x/y fields, not a WYSIWYG canvas; flagged as a deferred enhancement, not an oversight.
 */
model CanvaTemplate {
  id            String              @id @default(uuid())
  tenantId      String
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  type          TemplateType
  backgroundUrl String?
  layoutFields  Json?
  bodyTemplate  String?
  createdById   String?
  createdBy     EmployeeProfile?    @relation(fields: [createdById], references: [id])
  documents     GeneratedDocument[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([tenantId, type])
}

/**
 * One generated artifact from a template — a snapshot of the filled variables and the rendered output, kept as a record of what was actually issued.
 */
model GeneratedDocument {
  id              String           @id @default(uuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  templateId      String
  template        CanvaTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        EmployeeProfile  @relation("GeneratedDocumentSubject", fields: [employeeId], references: [id], onDelete: Cascade)
  variablesJson   Json
  renderedContent String
  generatedById   String?
  generatedBy     EmployeeProfile? @relation("GeneratedDocumentAuthor", fields: [generatedById], references: [id])
  createdAt       DateTime         @default(now())

  @@index([tenantId, employeeId])
  @@index([templateId])
}

enum AnnouncementAudience {
  ALL
  DEPARTMENT
}

model Announcement {
  id            String               @id @default(uuid())
  tenantId      String
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title         String
  body          String
  audience      AnnouncementAudience @default(ALL)
  department    String?
  publishedById String?
  publishedBy   EmployeeProfile?     @relation(fields: [publishedById], references: [id])
  expiresAt     DateTime?
  createdAt     DateTime             @default(now())

  @@index([tenantId, createdAt])
}

model Subscription {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planName  String // e.g. Free, Pro, Enterprise
  status    String // e.g. ACTIVE, CANCELLED
  seats     Int      @default(5)
  expiresAt DateTime
}

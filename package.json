{
  "name": "grow-more",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "nodemon --watch src/server --ext ts -x tsx src/server/server.ts",
    "build": "npm run build:server && npm run build:client",
    "build:client": "tsc -b tsconfig.json && vite build",
    "build:server": "prisma generate && prisma migrate deploy && tsc -p tsconfig.server.json",
    "start": "node dist/server/server.js",
    "postinstall": "prisma generate",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck:client": "tsc -b tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:client": "vitest run --config vitest.client.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:db:push": "prisma db push",
    "rbac:seed": "tsx prisma/seed-rbac.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@prisma/client": "^6.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.112.1",
    "@tanstack/react-query": "^5.104.5",
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "docx": "^9.14.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "framer-motion": "^11.18.2",
    "googleapis": "^174.0.1",
    "helmet": "^8.3.0",
    "input-otp": "^1.5.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.474.0",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "otplib": "^13.5.0",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^6.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^6.2.4",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.6.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.13.2",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^9.1.2",
    "jsdom": "^30.1.3",
    "msw": "^2.15.0",
    "nodemon": "^3.1.9",
    "oxlint": "^1.89.0",
    "pino-pretty": "^13.2.0",
    "prisma": "^6.2.1",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.10"
  }
}
